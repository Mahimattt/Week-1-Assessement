def check_number(n):
    if n < 2:
        if n % 2 == 0:
            return "Even"
        else:
            return "Odd"

    is_prime = True

    for i in range(2, n):
        if n % i == 0:
            is_prime = False
            break

    if is_prime:
        return "Prime"
    elif n % 2 == 0:
        return "Even"
    else:
        return "Odd"


num = int(input("Enter a number: "))
print(check_number(num))
